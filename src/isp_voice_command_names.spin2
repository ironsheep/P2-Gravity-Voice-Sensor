'' =================================================================================================
''
''   File....... isp_voice_command_names.spin2
''   Purpose.... OPTIONAL human-readable phrase lookup for DF2301Q command-word IDs.
''               Include this object only when you want the phrase strings (e.g. to print the
''               recognized command); it adds the string table to the binary. Apps that only need
''               to react by ID use the CMD_* constants in isp_voice_recognizer (which are free).
''   Author..... Stephen M Moraco
''               Copyright (c) 2026 Iron Sheep Productions, LLC
''   E-mail..... stephen@ironsheep.biz
''   Started.... 04 Jun 2026
''   Updated.... 07 Jun 2026
''
''   Note....... IDs mirror isp_voice_recognizer's CMD_* constants (both ported from the reference
''               DFRobot_DF2301Q_Commands.py). Validate against the product's command-word card (#9).
''
'' =================================================================================================


PUB null()
'' This is not a top-level object.
''


PUB cmdName(cmdId) : pStr
'' Return a pointer to the human-readable phrase for a DF2301Q command-word ID.
''
'' @param cmdId - command-word ID to look up
'' @returns pStr - pointer to the phrase ("(none)" for 0, "(custom)" for slots 5..21, "(unknown)" if unmapped)

  case cmdId
    0:   pStr := string("(none)")
    1:   pStr := string("Wake-up Words For Learning")
    2:   pStr := string("Hello Robot")
    5..21: pStr := string("(custom)")
    22:  pStr := string("Go Forward")
    23:  pStr := string("Retreat")
    24:  pStr := string("Park A Car")
    25:  pStr := string("Turn Left 90 Degrees")
    26:  pStr := string("Turn Left 45 Degrees")
    27:  pStr := string("Turn Left 30 Degrees")
    29:  pStr := string("Turn Right 45 Degrees")
    30:  pStr := string("Turn Right 30 Degrees")
    31:  pStr := string("Shift Down A Gear")
    32:  pStr := string("Line Tracking Mode")
    33:  pStr := string("Light Tracking Mode")
    34:  pStr := string("Bluetooth Mode")
    35:  pStr := string("Obstacle Avoidance Mode")
    36:  pStr := string("Face Recognition")
    37:  pStr := string("Object Tracking")
    38:  pStr := string("Object Recognition")
    39:  pStr := string("Line Tracking")
    40:  pStr := string("Color Recognition")
    41:  pStr := string("Tag Recognition")
    42:  pStr := string("Object Sorting")
    43:  pStr := string("QR Code Recognition")
    44:  pStr := string("General Settings")
    45:  pStr := string("Clear Screen")
    46:  pStr := string("Learn Once")
