{Spin2_v50}
'' =================================================================================================
''
''   File....... demo_voice_recognizer.spin2
''   Purpose.... Demo / top object for the isp_voice_recognizer driver (DFRobot DF2301Q, I2C).
''               Interactive DEBUG PLOT control panel: clickable buttons (read with PC_MOUSE) select
''               the driver's three usage profiles and exercise wake/volume/mute, with a live
''               recognized-CMDID readout. Artwork is in panel_bg.bmp / panel_font.bmp (generated by
''               tools/gen_panel_assets.py). See DOCs/dbg-display-theory/ for the technique.
''   Author..... Stephen M Moraco
''               Copyright (c) 2026 Iron Sheep Productions, LLC
''   E-mail..... stephen@ironsheep.biz
''   Started.... 04 Jun 2026
''
''   Run........ cd src && pnut-term-ts -r demo_voice_recognizer.bin -b 2000000   (windowed, on host)
''
'' =================================================================================================


CON

  _clkfreq   = 200_000_000                                     ' 20 MHz xtal x PLL
  DEBUG_BAUD = 2_000_000                                       ' MUST match pnut-term-ts -b 2000000

  ' ---- wiring: EDIT these for your board -----------------------------------------------------------
  SCL_PIN  = 18                                                ' DF2301Q I2C clock pin (SCL)
  SDA_PIN  = 16                                                ' DF2301Q I2C data pin  (SDA)
  BUS_KHZ  = 100                                               ' 100 (standard) / 400 / 1000

  VOL_MIN  = 0
  VOL_MAX  = 20                                                ' documented 1-7; wider to explore F2

  ' ---- panel layout (generated by tools/gen_panel_assets.py; keep in sync with the BMPs) -----------
  WIN_W = 480
  WIN_H = 412
  DIGIT_W = 38
  DIGIT_H = 62
  BLANK_CELL = 10
  MUTE_CELL = 11
  BTN_W = 105
  BTN_H = 44
  CMD_Y = 69
  CMD_X0 = 68
  CMD_X1 = 106
  CMD_X2 = 144
  VOL_Y = 69
  VOL_X0 = 342
  VOL_X1 = 380
  ' recognized-phrase line (PLOT TEXT)
  PHRASE_X = 90
  PHRASE_Y = 284
  PHRASE_TSIZE = 18
  PHRASE_CLR_X = 86
  PHRASE_CLR_Y = 276
  PHRASE_CLR_W = 390
  PHRASE_CLR_H = 42
  BTN_SYNC_X1  = 15
  BTN_SYNC_Y1  = 156
  BTN_SYNC_X2  = 120
  BTN_SYNC_Y2  = 200
  BTN_SCAN_X1  = 130
  BTN_SCAN_Y1  = 156
  BTN_SCAN_X2  = 235
  BTN_SCAN_Y2  = 200
  BTN_POLL_X1  = 245
  BTN_POLL_Y1  = 156
  BTN_POLL_X2  = 350
  BTN_POLL_Y2  = 200
  BTN_STOP_X1  = 360
  BTN_STOP_Y1  = 156
  BTN_STOP_X2  = 465
  BTN_STOP_Y2  = 200
  BTN_WAKE_X1  = 15
  BTN_WAKE_Y1  = 222
  BTN_WAKE_X2  = 120
  BTN_WAKE_Y2  = 266
  BTN_VOLUP_X1 = 130
  BTN_VOLUP_Y1 = 222
  BTN_VOLUP_X2 = 235
  BTN_VOLUP_Y2 = 266
  BTN_VOLDN_X1 = 245
  BTN_VOLDN_Y1 = 222
  BTN_VOLDN_X2 = 350
  BTN_VOLDN_Y2 = 266
  BTN_MUTE_X1  = 360
  BTN_MUTE_Y1  = 222
  BTN_MUTE_X2  = 465
  BTN_MUTE_Y2  = 266
  ' SPEAK row: target line (PLOT TEXT) + ID-/ID+/Speak hit-zones
  SPKTGT_ID_X = 95
  SPKTGT_PH_X = 150
  SPKTGT_Y = 326
  SPK_TSIZE = 18
  SPKTGT_CLR_X = 90
  SPKTGT_CLR_Y = 320
  SPKTGT_CLR_W = 386
  SPKTGT_CLR_H = 26
  BTN_SPK_IDDN_X1 = 15
  BTN_SPK_IDDN_Y1 = 356
  BTN_SPK_IDDN_X2 = 120
  BTN_SPK_IDDN_Y2 = 400
  BTN_SPK_IDUP_X1 = 130
  BTN_SPK_IDUP_Y1 = 356
  BTN_SPK_IDUP_X2 = 235
  BTN_SPK_IDUP_Y2 = 400
  BTN_SPK_PLAY_X1 = 245
  BTN_SPK_PLAY_Y1 = 356
  BTN_SPK_PLAY_X2 = 465
  BTN_SPK_PLAY_Y2 = 400
  SPK_ID_MAX = 208

  ' usage-profile modes
  #0, MODE_IDLE, MODE_SYNC, MODE_SCAN, MODE_POLL


OBJ

  voice : "isp_voice_recognizer"                               ' the driver under demonstration
  i2c   : "isp_i2c_singleton"                                  ' referenced for the PU_* constants
  names : "isp_voice_command_names"                            ' optional ID -> phrase lookup


VAR

  long  mode                                                   ' current usage profile (MODE_*)
  long  curVol                                                 ' last volume sent
  long  muteOn                                                 ' mute state 0/1
  long  wakeTestId                                             ' F1: CMDID the Wake button plays next (1 or 2)
  long  speakId                                                ' SPEAK row: target command ID to play (0..SPK_ID_MAX)
  long  key                                                    ' PC_KEY result (keyboard type-in for speakId)
  long  lastHeardId                                            ' id of last recognized command (0 = none yet)
  long  lastHeard                                              ' ptr to phrase of last recognized command (HEARD line)
  long  doneStr                                                ' ptr to "" before first recognition, "done" after
  long  lastSpoken                                             ' ptr to phrase of last played command (SPOKEN line)
  long  dirty                                                  ' redraw pending

  ' PC_MOUSE writes 7 consecutive longs -- keep these adjacent and in this order
  long  mx, my, mwheel, mlb, mmb, mrb, mpix


PUB main() | cmdId, prevLb, lastMx, lastMy, lastLb

'' Build the panel, init the sensor, then run the click-driven control loop

  setup()

  mode := MODE_IDLE
  paintModeBtn(MODE_IDLE, true)                                ' show Stop/idle selected at startup
  wakeTestId := 1                                              ' F1 experiment starts with candidate CMDID 1
  speakId := 1                                                 ' SPEAK row target ID starts at 1
  lastHeardId := 0                                             ' no command heard yet
  lastHeard := lastSpoken := string("--")                      ' TERM readout starts blank
  doneStr := string(" ")                                       ' "done" appears only after a recognition
  curVol := voice.getVolume()                                  ' driver set DEF_VOLUME at start(); track its shadow
  voice.setMuteMode(0)
  ' Bring-up diagnostic: getWakeTime cross-checks the READ path (a non-zero result proves readReg
  ' can read non-zero values, so 0x02=0 is the module's true state) AND reports the wake window.
  debug("wakeTime BEFORE = ", udec_(voice.getWakeTime()))
  voice.setWakeTime(15)                                         ' match the reference: 15s wake window
  debug("wakeTime AFTER  = ", udec_(voice.getWakeTime()))
  clearCmd()
  showVol(curVol)                                              ' VOLUME known from the driver's shadow
  redrawTerm()                                                 ' paint the HEARD/TARGET/SPOKEN readout
  debug(`vp update)

  prevLb := 0
  lastMx := lastMy := lastLb := $7FFF_FFFF                     ' force the first MOUSE report
  repeat
    cmdId := readActive()                                      ' poll the sensor per current mode
    if cmdId
      showCmd(cmdId)                                           ' numeric ID in the readout box
      lastHeardId := cmdId                                     ' id + words + "done" go to the TERM HEARD line
      lastHeard := names.cmdName(cmdId)
      doneStr := string("done")
      redrawTerm()
      debug("CMDID ", udec_(cmdId), " = ", zstr_(names.cmdName(cmdId)), "  done")   ' recognition to the log

    debug(`vp `pc_mouse(@mx))                                  ' poll mouse (MUST be last in stmt)

    ' DIAGNOSTIC: report mouse state ONLY when it changes -- tells us whether pc_mouse delivers
    ' data, without flooding the log every poll. (The bare `PC_MOUSE` lines are the poll requests.)
    if (mx <> lastMx) or (my <> lastMy) or (mlb <> lastLb)
      debug("MOUSE x=", sdec_(mx), " y=", sdec_(my), " lb=", sdec_(mlb))
      lastMx := mx
      lastMy := my
      lastLb := mlb

    if mlb and (not prevLb)                                    ' left-button press edge (-1 = down)
      handleClick(mx, (WIN_H - 1) - my)                        ' pc_mouse y is bottom-left origin; flip to top-left art
    prevLb := mlb

    key := 0
    debug(`vp `pc_key(@key))                                   ' poll keyboard (MUST be last in stmt)
    if key
      handleKey(key)                                           ' type-in the SPEAK target ID

    if dirty
      debug(`vp update)
      dirty := false
    waitms(100)                                                ' ~10 polls/sec (less PC_MOUSE noise)


PRI setup()

'' Create the PLOT window, load the artwork layers, and probe the sensor

  debug(`plot vp title 'DF2301Q Voice' size 480 412 pos 100 100 hidexy update)
  debug(`vp layer 1 'panel_bg.bmp')                            ' background + buttons
  debug(`vp layer 2 'panel_font.bmp')                          ' green digit strip
  debug(`vp layer 3 'panel_hi.bmp')                            ' selected-mode button highlights
  debug(`vp crop 1)                                            ' paint the full background
  debug(`vp update)

  ' TERM window docked under the panel -- the words (HEARD/TARGET/SPOKEN) live here because this
  ' host renders TERM text natively (it does NOT render PLOT vector TEXT).
  ' Width: measured -- 50 cols was ~25% too wide, so the panel (WIN_W = 480 px) ~= 40 columns at
  ' textsize 16 (~12 px/glyph).  Labels are kept short so the longest line fits within 40 columns.
  ' NOTE: do NOT add a `color` token to this create line -- this host's TERM create rejects it and
  ' the window then never receives routed output (nothing displays).
  debug(`term hs title 'DF2301Q  Heard / Browse / Spoken' pos 100 560 size 40 4 textsize 16)

  ' RAW PIN TEST (bring-up): before any I2C config, drive each pin push-pull hi/lo and read back.
  ' HIGH should read 1; if it reads 0 the line is shorted/held low or the pin number is wrong.
  pinlow(SCL_PIN)
  pinlow(SDA_PIN)
  waitms(2)
  debug("rawpin LOW  scl=", udec_(pinread(SCL_PIN)), " sda=", udec_(pinread(SDA_PIN)))
  pinhigh(SCL_PIN)
  pinhigh(SDA_PIN)
  waitms(2)
  debug("rawpin HIGH scl=", udec_(pinread(SCL_PIN)), " sda=", udec_(pinread(SDA_PIN)))
  pinfloat(SCL_PIN)
  pinfloat(SDA_PIN)

  ' PU_1K5 = P2 drives a strong ~1.5k internal pull-up (PU_3K3's 1mA source idled the bus low).
  ' Use i2c.PU_NONE instead if the module/board already provides external pull-ups.
  repeat until voice.start(SCL_PIN, SDA_PIN, BUS_KHZ, i2c.PU_1K5)
    debug("DF2301Q not found - check wiring (SCL=18 SDA=16)")
    waitms(2000)
  debug("DF2301Q ready: ", zstr_(voice.version()))


PRI readActive() : cmdId

'' Read the latest command ID using the access path for the current mode (0 = none)

  case mode
    MODE_SYNC: cmdId := voice.getCMDID()                       ' simple synchronous
    MODE_SCAN: cmdId := voice.pollCMDID()                      ' passive scanner poll
    MODE_POLL: cmdId := voice.getLatest()                      ' self-poller cog mailbox
    other:     cmdId := 0                                      ' idle / stopped


PRI handleClick(x, y)

'' Map a left-click to a control (bounding-box dispatch)

  if inZone(x, y, BTN_SYNC_X1, BTN_SYNC_Y1, BTN_SYNC_X2, BTN_SYNC_Y2)
    setMode(MODE_SYNC)
  elseif inZone(x, y, BTN_SCAN_X1, BTN_SCAN_Y1, BTN_SCAN_X2, BTN_SCAN_Y2)
    setMode(MODE_SCAN)
  elseif inZone(x, y, BTN_POLL_X1, BTN_POLL_Y1, BTN_POLL_X2, BTN_POLL_Y2)
    setMode(MODE_POLL)
  elseif inZone(x, y, BTN_STOP_X1, BTN_STOP_Y1, BTN_STOP_X2, BTN_STOP_Y2)
    setMode(MODE_IDLE)
  elseif inZone(x, y, BTN_WAKE_X1, BTN_WAKE_Y1, BTN_WAKE_X2, BTN_WAKE_Y2)
    busAction()
    ' F1 bring-up: alternate the played CMDID 1<->2 to find which one wakes the module.
    ' Echo it into the CMD-ID box (visual feedback) and log it; listen for the wake chime,
    ' or speak a command afterward and watch for a recognized CMDID. Once F1 is resolved,
    ' this reverts to voice.enterWakeState() and the driver's constant is set accordingly.
    voice.playByCMDID(wakeTestId)
    showCmd(wakeTestId)
    lastSpoken := names.cmdName(wakeTestId)                    ' TERM SPOKEN line
    redrawTerm()
    debug("WAKE play CMDID=", udec_(wakeTestId), "  (F1: did the module wake?)")
    if wakeTestId == 1
      wakeTestId := 2
    else
      wakeTestId := 1
  elseif inZone(x, y, BTN_VOLUP_X1, BTN_VOLUP_Y1, BTN_VOLUP_X2, BTN_VOLUP_Y2)
    busAction()
    curVol := (curVol + 1) <# VOL_MAX
    voice.setVolume(curVol)
    showVol(curVol)
  elseif inZone(x, y, BTN_VOLDN_X1, BTN_VOLDN_Y1, BTN_VOLDN_X2, BTN_VOLDN_Y2)
    busAction()
    curVol := (curVol - 1) #> VOL_MIN
    voice.setVolume(curVol)
    showVol(curVol)
  elseif inZone(x, y, BTN_MUTE_X1, BTN_MUTE_Y1, BTN_MUTE_X2, BTN_MUTE_Y2)
    busAction()
    muteOn ^= 1
    voice.setMuteMode(muteOn)
    showVol(curVol)                                           ' show mute glyph, or restore the number
  elseif inZone(x, y, BTN_SPK_IDDN_X1, BTN_SPK_IDDN_Y1, BTN_SPK_IDDN_X2, BTN_SPK_IDDN_Y2)
    speakId := (speakId - 1) #> 0                              ' SPEAK: step target ID down
    showTarget()
  elseif inZone(x, y, BTN_SPK_IDUP_X1, BTN_SPK_IDUP_Y1, BTN_SPK_IDUP_X2, BTN_SPK_IDUP_Y2)
    speakId := (speakId + 1) <# SPK_ID_MAX                     ' SPEAK: step target ID up
    showTarget()
  elseif inZone(x, y, BTN_SPK_PLAY_X1, BTN_SPK_PLAY_Y1, BTN_SPK_PLAY_X2, BTN_SPK_PLAY_Y2)
    skipToNextNamed()                                         ' BROWSE: jump to the next real catalog phrase


PRI handleKey(keyVal)

'' Keyboard type-in for the SPEAK target ID: digits build the number, Backspace deletes a digit,
'' Enter plays it.  (PC_KEY: digits = ASCII '0'..'9' = 48..57; Backspace = 8; Enter = 13.)

  if (keyVal >= "0") and (keyVal <= "9")
    speakId := (speakId * 10) + (keyVal - "0")
    if speakId > SPK_ID_MAX
      speakId := keyVal - "0"                                  ' overflow -> restart from this digit
    showTarget()
  elseif keyVal == 8                                          ' Backspace
    speakId := speakId / 10
    showTarget()
  elseif keyVal == 13                                         ' Enter -> skip to next named phrase
    skipToNextNamed()


PRI showTarget()

'' BROWSE target changed -- the readout (id + phrase) lives on the TERM's BROWSE line.

  redrawTerm()


PRI skipToNextNamed()

'' BROWSE: advance the target ID to the next command that has a real catalog phrase, skipping the
'' (none)/(custom)/(unknown) gaps -- those sentinel phrases all begin with "(".

  repeat
    speakId := (speakId + 1) <# SPK_ID_MAX
  until (byte[names.cmdName(speakId)] <> "(") or (speakId == SPK_ID_MAX)
  showTarget()


PRI redrawTerm() | pTgt

'' Repaint the docked TERM readout: clear+home, then HEARD / TARGET / SPOKEN.  TERM text is native
'' to this host (unlike PLOT vector TEXT).  Control bytes: 12 = form-feed (clear+home), 13 = newline.

'' Named-TERM output MUST use the CLOSING-backtick form -- debug(`hs <items> `) -- or the items are
'' dumped as raw, unevaluated source.  12 = form-feed (clear+home), 13 = newline.  Avoid literal
'' "(" / ")" in fixed strings (the backtick parser truncates at ")"); runtime zstr_ strings are fine.

  pTgt := names.cmdName(speakId)
  debug(`hs 12 'HEARD : ' `udec_(lastHeardId) ' ' `zstr_(lastHeard) ' ' `zstr_(doneStr) 13)
  debug(`hs 'BROWSE: ' `udec_(speakId) ' ' `zstr_(pTgt) 13)
  debug(`hs 'SPOKEN: ' `zstr_(lastSpoken) 13)


PRI busAction()

'' A direct-bus action needs the bus; if the poller cog owns it, stop the poller first
'' (bus-ownership contract -- foreground and poller must not share the bus)

  if mode == MODE_POLL
    setMode(MODE_IDLE)


PRI setMode(newMode)

'' Switch usage profile, starting/stopping the poller cog as needed, and clear the readout

  if (mode == MODE_POLL) and (newMode <> MODE_POLL)
    voice.stopPoller()
  paintModeBtn(mode, false)                                    ' deselect the old mode button
  mode := newMode
  paintModeBtn(mode, true)                                     ' highlight the new active mode button
  if newMode == MODE_POLL
    voice.startPoller()
  clearCmd()


PRI paintModeBtn(m, active) | bx, by, idx

'' Show/hide the selected-mode highlight for mode m: blit highlight cell idx from layer 3
'' when active, else restore that button's pixels from the clean background (layer 1).

  case m
    MODE_SYNC: bx, by, idx := BTN_SYNC_X1, BTN_SYNC_Y1, 0
    MODE_SCAN: bx, by, idx := BTN_SCAN_X1, BTN_SCAN_Y1, 1
    MODE_POLL: bx, by, idx := BTN_POLL_X1, BTN_POLL_Y1, 2
    MODE_IDLE: bx, by, idx := BTN_STOP_X1, BTN_STOP_Y1, 3
    other:     return
  if active
    debug(`vp crop 3 `(idx * BTN_W, 0, BTN_W, BTN_H, bx, by))
  else
    debug(`vp crop 1 `(bx, by, BTN_W, BTN_H, bx, by))
  dirty := true


PRI showCmd(numVal)

'' Blit a recognized CMDID (right-aligned, leading blanks) into the CMD-ID box

  blitDigit(CMD_X2, CMD_Y, numVal // 10)
  if numVal >= 10
    blitDigit(CMD_X1, CMD_Y, numVal / 10 // 10)
  else
    blitDigit(CMD_X1, CMD_Y, BLANK_CELL)
  if numVal >= 100
    blitDigit(CMD_X0, CMD_Y, numVal / 100 // 10)
  else
    blitDigit(CMD_X0, CMD_Y, BLANK_CELL)
  dirty := true


PRI clearCmd()

'' Blank the CMD-ID box (all three digit slots) and the recognized-phrase line

  blitDigit(CMD_X0, CMD_Y, BLANK_CELL)
  blitDigit(CMD_X1, CMD_Y, BLANK_CELL)
  blitDigit(CMD_X2, CMD_Y, BLANK_CELL)
  clearPhrase()
  dirty := true


PRI showPhrase(pStr)

'' Draw the recognized phrase (zero-terminated string at pStr) on the HEARD line.
'' Erase the prior phrase first by repainting that strip from the clean background (layer 1).

  clearPhrase()
  debug(`vp set `(PHRASE_X) `(PHRASE_Y) color green textsize `(PHRASE_TSIZE) text '`zstr_(pStr)')
  dirty := true


PRI clearPhrase()

'' Repaint the phrase strip from the clean background, erasing any prior phrase text

  debug(`vp crop 1 `(PHRASE_CLR_X, PHRASE_CLR_Y, PHRASE_CLR_W, PHRASE_CLR_H, PHRASE_CLR_X, PHRASE_CLR_Y))
  dirty := true


PRI clearVol()

'' Blank the VOLUME box -- used at startup when the module-retained volume is unknown

  blitDigit(VOL_X0, VOL_Y, BLANK_CELL)
  blitDigit(VOL_X1, VOL_Y, BLANK_CELL)
  dirty := true


PRI showVol(numVal)

'' Blit the current volume (right-aligned, leading blank) into the VOLUME box,
'' or the mute glyph when muted (numVal is preserved so unmute restores the number)

  if muteOn
    blitDigit(VOL_X0, VOL_Y, BLANK_CELL)
    blitDigit(VOL_X1, VOL_Y, MUTE_CELL)
    dirty := true
    return
  if numVal >= 10
    blitDigit(VOL_X0, VOL_Y, numVal / 10 // 10)
  else
    blitDigit(VOL_X0, VOL_Y, BLANK_CELL)
  blitDigit(VOL_X1, VOL_Y, numVal // 10)
  dirty := true


PRI blitDigit(destX, destY, cell)

'' Copy one font cell (digit 0-9 or BLANK_CELL) from layer 2 to (destX, destY)

  debug(`vp crop 2 `(cell * DIGIT_W, 0, DIGIT_W, DIGIT_H, destX, destY))


PRI inZone(x, y, x1, y1, x2, y2) : hit

'' Bounding-box hit test (top-left coordinate basis)

  hit := (x >= x1) and (x < x2) and (y >= y1) and (y < y2)
